# IT Asset Management System - Environment Configuration Template
# Phase P02: PostgreSQL Data Architecture

# Server Configuration
PORT=3000
# Default host is strictly local loopback (127.0.0.1).
# To expose on a private network or container interface, explicitly set HOST="0.0.0.0" (opt-in).
HOST="127.0.0.1"
NODE_ENV="development"

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# For Ubuntu Linux standalone deployment or WSL2, replace with your local PostgreSQL credentials:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/it_asset_management?schema=public"

# Authentication & Session Security (Phase P03)
# SESSION_SECRET: Required in production. Minimum 32-character secret for signing session cookies.
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# COOKIE_SECURE: Set to "true" when running behind HTTPS/SSL. Defaults to "false" on localhost HTTP.
COOKIE_SECURE="false"

# ADMIN_BOOTSTRAP_PASSWORD: Optional secret environment variable for non-interactive bootstrap by Ubuntu installer.
# If omitted, `npm run admin:bootstrap` prompts for the password interactively with hidden terminal input.
# ADMIN_BOOTSTRAP_PASSWORD=""
